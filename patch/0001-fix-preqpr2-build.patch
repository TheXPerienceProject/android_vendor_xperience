From 742d82d6e569621f8f15afe2b59a4d1f0a9cc2ac Mon Sep 17 00:00:00 2001
From: klozz <carlosj@klozz.dev>
Date: Sat, 7 Jun 2025 06:58:00 -0600
Subject: [PATCH] fix preqpr2 build

Change-Id: I7404cb121af76c1e431e365a72d4e77850689400
Signed-off-by: klozz <carlosj@klozz.dev>
---
 Android.bp              | 20 ++------------------
 soong/clangprebuilts.go |  3 ---
 2 files changed, 2 insertions(+), 21 deletions(-)

diff --git a/Android.bp b/Android.bp
index c5e337cf..fc1f1cad 100644
--- a/Android.bp
+++ b/Android.bp
@@ -55,21 +55,12 @@ llvm_prebuilt_library_static {
     },
 }
 
-// All libclang_rt.* modules are available to the platform except
-// hwasan, which is distributed as part of the runtime apex.
 cc_defaults {
-    name: "libclang_rt-prebuilt-non-platform-default",
+    name: "libclang_rt-prebuilt-default",
     ramdisk_available: true,
     vendor_ramdisk_available: true,
     apex_available: [
         "//apex_available:anyapex",
-    ],
-}
-
-cc_defaults {
-    name: "libclang_rt-prebuilt-default",
-    defaults: ["libclang_rt-prebuilt-non-platform-default"],
-    apex_available: [
         "//apex_available:platform",
     ],
 }
@@ -229,9 +220,8 @@ libclang_rt_prebuilt_library_shared {
     },
     check_elf_files: false, // Bypass circular dependency between libc++
     is_llndk: true,
-    llndk_moved_to_apex: true,
     defaults: [
-        "libclang_rt-prebuilt-non-platform-default",
+        "libclang_rt-prebuilt-default",
     ],
 }
 
@@ -580,9 +570,3 @@ filegroup {
         "clang-stable/lib/libclang.so",
     ],
 }
-
-dirgroup {
-    name: "trusty_dirgroup_prebuilts_clang_host_linux-x86",
-    dirs: ["."],
-    visibility: ["//trusty/vendor/google/aosp/scripts"],
-}
diff --git a/soong/clangprebuilts.go b/soong/clangprebuilts.go
index 3406023e..40006081 100644
--- a/soong/clangprebuilts.go
+++ b/soong/clangprebuilts.go
@@ -399,7 +399,6 @@ func llvmPrebuiltBuildTool(ctx android.LoadHookContext) {
 
 type prebuiltLibrarySharedProps struct {
 	Is_llndk            *bool
-	Llndk_moved_to_apex *bool
 
 	Shared_libs []string
 }
@@ -437,7 +436,6 @@ func libClangRtPrebuiltLibraryShared(ctx android.LoadHookContext, libProps *preb
 		}
 		Llndk struct {
 			Symbol_file   *string
-			Moved_to_apex *bool
 		}
 	}
 
@@ -485,7 +483,6 @@ func libClangRtPrebuiltLibraryShared(ctx android.LoadHookContext, libProps *preb
 
 	if proptools.Bool(sharedProps.Is_llndk) {
 		p.Stubs.Versions = []string{"29", "10000"}
-		p.Llndk.Moved_to_apex = sharedProps.Llndk_moved_to_apex
 		// Set the symbol_file of the "base" variant to a fake file. This will be overridden later.
 		// This is necessary today since `image` mutator which creates the llndk variants runs before `arch` mutator.
 		// Without this hack, the llndk variants will not be created.
-- 
2.49.0

